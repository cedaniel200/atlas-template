# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca commitees credenciales reales.

# ─── Aplicación ─────────────────────────────────────────────
APP_PORT=<puerto>
APP_ENV=<development|test|production>

# ─── Base de datos ──────────────────────────────────────────
DB_HOST=<host>
DB_PORT=<puerto>
DB_NAME=<nombre>
DB_USER=<usuario>
DB_PASSWORD=<password>

# ─── Observabilidad (si aplica) ─────────────────────────────
HEALTH_PATH=<ruta>
METRICS_PATH=<ruta>
HEALTH_AUTH=<none|basic|bearer>

# ─── Integraciones opcionales ───────────────────────────────
# CONTEXT7_API_KEY=<clave>
# ENGRAM_HOME=<ruta>
