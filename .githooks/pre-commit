#!/bin/sh
# pre-commit dispatcher — runs every guard in pre-commit.d/ in lexicographic
# order and aborts at the first failure.
#
# Adding a guard is adding an executable file: this dispatcher never changes.
# Each guard owns its skip semantics; the dispatcher only chains them.

case "$0" in
    */*) hooks_dir=${0%/*} ;;
    *) hooks_dir=. ;;
esac

guards="$hooks_dir/pre-commit.d"
[ -d "$guards" ] || exit 0

for guard in "$guards"/*; do
    [ -f "$guard" ] || continue
    nombre=${guard##*/}
    if [ ! -x "$guard" ]; then
        echo "⚠️  pre-commit: skipping non-executable guard '$nombre'."
        continue
    fi
    if ! "$guard"; then
        echo "❌ pre-commit: guard '$nombre' failed; commit aborted."
        exit 1
    fi
done

exit 0
